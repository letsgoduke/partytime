{
  "name": "partytime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "test:db": "node supabase/tests/run-security.mjs",
    "format": "prettier --write src tests scripts *.ts *.json docs README.md",
    "format:check": "prettier --check src tests scripts *.ts *.json docs README.md",
    "check": "npm run build && npm test && npm run test:db",
    "test:contract": "TEST_LIVE_CONTRACT=1 VITE_SUPABASE_URL=https://contract.supabase.co VITE_SUPABASE_ANON_KEY=contract-test-key playwright test tests/live-contract.spec.ts --workers=1",
    "icons": "node scripts/generate-icons.mjs",
    "validate:env": "node scripts/validate-env.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.90.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
